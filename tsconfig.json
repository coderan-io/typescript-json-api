{
    "compilerOptions": {
        "target": "ES2023",
        "module": "nodenext",
        "lib": ["ES2023"],
        "types": ["node"],
        "strict": true,
        "declaration": true,
        "rootDir": "src",
        "outDir": "dist",
        "rewriteRelativeImportExtensions": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "skipLibCheck": true
    },
    "include": ["src"]
}
